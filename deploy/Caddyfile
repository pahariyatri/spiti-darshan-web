# /etc/caddy/Caddyfile — automatic HTTPS (Let's Encrypt), compression, headers, static caching.
# Replace your-domain.example with the verified domain (and set PUBLIC_SITE_URL to match).

www.your-domain.example {
	redir https://your-domain.example{uri} permanent
}

your-domain.example {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Fingerprinted/immutable assets.
	@immutable path /_astro/* /fonts/* /media/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Admin uploads straight from disk (same filename rule as the app endpoint).
	@uploads path_regexp uploads ^/uploads/[a-z0-9-]+-(\d+|og)\.(avif|webp|jpg)$
	handle @uploads {
		root * /srv/spiti-darshan/shared
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Caddy sets X-Forwarded-For itself; the app trusts only the right-most hop (TRUST_PROXY=true).
	reverse_proxy 127.0.0.1:4321

	log {
		output file /var/log/caddy/spiti-darshan.access.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}
