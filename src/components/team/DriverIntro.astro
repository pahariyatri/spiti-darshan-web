---
import WhatsAppLink from '../conversion/WhatsAppLink.astro';
import { drivers } from '../../content/team';
interface Props {
  showStory?: boolean;
}
const { showStory = true } = Astro.props;
---

<section class="driver-intro" id="your-driver" aria-labelledby="driverTitle">
  <div class="shell driver-grid">
    <div class="driver-copy">
      <div class="eyebrow">Meet your drivers</div>
      <h2 id="driverTitle">
        Your drivers.
        <br />
        <em>Part of the journey.</em>
      </h2>
      <p>
        Meet Mukul and Rajat, our Innova Crysta drivers. Message us to confirm your driver and
        vehicle for your travel dates.
      </p>
      <WhatsAppLink class="day-enquire" cta="page">
        Ask about your driver <span aria-hidden="true">↗</span>
      </WhatsAppLink>
      {showStory && (
        <p class="driver-story">
          Spiti Darshan began with three friends who became like brothers.{' '}
          <a href="/about/">Read our story →</a>
        </p>
      )}
    </div>
    <ul class="driver-topics">
      {drivers.map((driver) => (
        <li>
          <span class="driver-initial" aria-hidden="true">
            {driver.name.charAt(0)}
          </span>
          <div>
            <h3>{driver.name}</h3>
            <p>{driver.vehicle}</p>
            <span class="vehicle-registration">{driver.registration}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
