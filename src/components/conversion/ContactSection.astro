---
/* The closing invitation: what happens after one tap, shown as the WhatsApp chat itself. */
import { businessWhatsApp } from '../../lib/config/env';
import { buildWhatsAppMessage } from '../../lib/whatsapp/message';
import { staticMedia, toMediaView } from '../../lib/media/static-media';
import { SITE } from '../../lib/config/site';
import Icon from '../Icon.astro';
import Picture from '../Picture.astro';
import WhatsAppLink from './WhatsAppLink.astro';

interface Props {
  routeLabel?: string | null;
}
const { routeLabel } = Astro.props;
const number = businessWhatsApp();
const backdrop = toMediaView(staticMedia('day-langza'));
const preview = buildWhatsAppMessage({ routeLabel }).split('\n');
const packageName = routeLabel ? `${routeLabel} package` : 'Spiti trip plan';

const steps = [
  { title: 'Tap the button', text: 'WhatsApp opens with your message ready. Add your dates.' },
  { title: 'Get your package', text: 'Route, car, stays and price, sent to you on WhatsApp.' },
  { title: 'Confirm and go', text: 'We confirm every detail with you before you book.' },
];
---

<section class="contact" id="contact" aria-labelledby="contactTitle">
  <div class="contact-bg" aria-hidden="true">
    <Picture media={backdrop} sizes="100vw" alt="" />
  </div>
  <div class="shell contact-grid">
    <div class="contact-copy">
      <div class="eyebrow">Ready for the road?</div>
      <h2 id="contactTitle">
        One message.
        <br />
        <em>Your Spiti package on WhatsApp.</em>
      </h2>
      <ol class="contact-steps">
        {steps.map((s) => (
          <li>
            <strong>{s.title}</strong>
            <span>{s.text}</span>
          </li>
        ))}
      </ol>
      <WhatsAppLink
        class="button button-whatsapp contact-cta"
        cta="contact"
        routeLabel={routeLabel}
      >
        <Icon name="chat" size={20} /> Get my trip plan on WhatsApp
      </WhatsAppLink>
      <p class="contact-number">
        Or save our number:{' '}
        <WhatsAppLink cta="contact" routeLabel={routeLabel}>
          {number.display}
        </WhatsAppLink>
      </p>
    </div>

    <figure class="chat-phone" aria-labelledby="chatCaption">
      <div class="iphone" aria-hidden="true">
        <span class="iphone-btn iphone-action"></span>
        <span class="iphone-btn iphone-vol-up"></span>
        <span class="iphone-btn iphone-vol-down"></span>
        <span class="iphone-btn iphone-power"></span>
        <div class="iphone-screen">
          <div class="iphone-status">
            <span class="iphone-time">9:41</span>
            <span class="iphone-island"></span>
            <span class="iphone-icons">
              <svg viewBox="0 0 18 12" width="17" height="11">
                <rect x="0" y="8" width="3" height="4" rx="1" />
                <rect x="5" y="5.5" width="3" height="6.5" rx="1" />
                <rect x="10" y="3" width="3" height="9" rx="1" />
                <rect x="15" y="0" width="3" height="12" rx="1" />
              </svg>
              <svg viewBox="0 0 16 12" width="15" height="11">
                <path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0Z" />
                <path d="M3.4 6.8a6.5 6.5 0 0 1 9.2 0l-1.4 1.4a4.5 4.5 0 0 0-6.4 0Z" />
                <path d="M1.2 4.6a9.6 9.6 0 0 1 13.6 0l-1.4 1.4a7.6 7.6 0 0 0-10.8 0Z" />
              </svg>
              <svg viewBox="0 0 27 13" width="26" height="12">
                <rect
                  x="0.5"
                  y="0.5"
                  width="22"
                  height="12"
                  rx="3.8"
                  fill="none"
                  stroke="currentColor"
                  opacity=".4"
                />
                <rect x="2.2" y="2.2" width="17" height="8.6" rx="2.2" />
                <path d="M24.5 4.5v4c.9-.3 1.5-1.1 1.5-2s-.6-1.7-1.5-2Z" opacity=".4" />
              </svg>
            </span>
          </div>
          <div class="chat-bar">
            <svg class="chat-back" viewBox="0 0 12 20" width="11" height="19">
              <path
                d="M10 2 2 10l8 8"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <img src="/brand/spiti-darshan-mark.webp" alt="" width="36" height="36" />
            <span class="chat-title">
              <strong>{SITE.name}</strong>
              <small>Business account</small>
            </span>
            <span class="chat-actions">
              <svg viewBox="0 0 24 24" width="24" height="24">
                <rect
                  x="2"
                  y="6"
                  width="13"
                  height="12"
                  rx="3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                />
                <path
                  d="m15 10.5 6-3.5v10l-6-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"
                />
              </svg>
              <svg viewBox="0 0 24 24" width="21" height="21">
                <path
                  d="M6.6 3.5h2.6l1.3 4.1-2 1.5a12 12 0 0 0 6.4 6.4l1.5-2 4.1 1.3v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </div>
          <div class="chat-body">
            <span class="chat-day">Today</span>
            <span class="chat-secure">🔒 Messages are end-to-end encrypted.</span>
            <p class="bubble bubble-out">
              {preview.map((line) => (
                <span>{line}</span>
              ))}
              <small class="bubble-meta">
                9:41 <b>✓✓</b>
              </small>
            </p>
            <div class="bubble bubble-in">
              <span>Here’s your trip plan 🏔️</span>
              <div class="chat-doc">
                <span class="chat-doc-icon">
                  <Icon name="doc" size={20} />
                </span>
                <span>
                  <strong>{packageName}</strong>
                  <small>Route · Innova Crysta · Stays · Price</small>
                </span>
              </div>
              <span>Tell us if you’d like to change any stop.</span>
              <small class="bubble-meta">9:42</small>
            </div>
          </div>
          <div class="chat-input">
            <span class="chat-plus">+</span>
            <span class="chat-field"></span>
            <svg viewBox="0 0 24 24" width="22" height="22">
              <path
                d="M4 8.5A2.5 2.5 0 0 1 6.5 6h1.8l1.4-2h4.6l1.4 2h1.8A2.5 2.5 0 0 1 20 8.5v8a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              />
              <circle
                cx="12"
                cy="12.5"
                r="3.4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              />
            </svg>
            <svg viewBox="0 0 24 24" width="22" height="22">
              <rect
                x="8.5"
                y="3"
                width="7"
                height="12"
                rx="3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              />
              <path
                d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <span class="iphone-home"></span>
          <span class="iphone-glare"></span>
        </div>
      </div>
      <figcaption id="chatCaption">
        How it works on WhatsApp (illustration). We confirm the route, car and stay details before
        you book.
      </figcaption>
    </figure>
  </div>
</section>
