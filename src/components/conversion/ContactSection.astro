---
import { businessWhatsApp } from '../../lib/config/env';
import WhatsAppLink from './WhatsAppLink.astro';

interface Props {
  routeLabel?: string | null;
}
const { routeLabel } = Astro.props;
const number = businessWhatsApp();
---

<section class="contact" id="contact" aria-labelledby="contactTitle">
  <div class="eyebrow">Ready for the road?</div>
  <h2 id="contactTitle">
    Tell us your dates.
    <br />
    We'll plan the drive.
  </h2>
  <p>
    Send your dates, group size and pickup city. Get a trip plan and quote from Spiti Darshan on
    WhatsApp.
  </p>
  <WhatsAppLink class="button button-whatsapp" cta="contact" routeLabel={routeLabel}>
    Get my trip plan on WhatsApp ↗
  </WhatsAppLink>
  <p class="contact-number">
    WhatsApp{' '}
    <WhatsAppLink cta="contact" routeLabel={routeLabel}>
      {number.display}
    </WhatsAppLink>
  </p>
  <p class="smallprint" id="waNote">
    We’ll confirm the route, car and stay details before you book.
  </p>
</section>
