---
import WhatsAppLink from './WhatsAppLink.astro';

interface Props {
  routeLabel?: string | null;
}
const { routeLabel } = Astro.props;
---

<div class="mobile-book">
  <WhatsAppLink class="button button-whatsapp" cta="mobile-bar" routeLabel={routeLabel}>
    Plan my ride on WhatsApp ↗
  </WhatsAppLink>
</div>
