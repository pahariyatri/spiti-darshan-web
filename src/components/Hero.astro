---
import type { MediaView } from '../lib/domain/types';
import Header from './Header.astro';
import Icon from './Icon.astro';
import Picture from './Picture.astro';
import WhatsAppLink from './conversion/WhatsAppLink.astro';

interface Props {
  kicker: string;
  title: string;
  titleAccent: string;
  subtitle?: string | null;
  media: MediaView | null;
  routeLabel?: string | null;
  primaryCta?: string;
  /** Optional seasonal offer card (homepage). */
  offer?: {
    href: string;
    tag: string;
    title: string;
    trips: readonly { label: string; price: string }[];
    note: string;
  } | null;
  /** Where the hero photo was taken, shown as a small tag. */
  place?: string | null;
}

const {
  kicker,
  title,
  titleAccent,
  subtitle,
  media,
  routeLabel,
  primaryCta = 'Plan my ride on WhatsApp',
  offer = null,
  place = null,
} = Astro.props;
/* Only verified service facts (no ratings, counts or driver claims). */
const trust = [
  { icon: 'car', title: 'Innova Crysta', text: 'Just your group' },
  { icon: 'route', title: 'Flexible stops', text: 'Your pace, your plan' },
  { icon: 'shield', title: 'Route checked', text: 'For your travel dates' },
] as const;
---

<section class="hero" id="top" aria-labelledby="heroTitle">
  <div class="hero-photo">{media && <Picture media={media} sizes="100vw" priority />}</div>
  {offer && <div class="snowfall hero-snow" aria-hidden="true" />}
  <Header routeLabel={routeLabel} homeHref="/" />
  <div class="shell">
    <div class="hero-copy">
      <div class="hero-kicker">{kicker}</div>
      <h1 id="heroTitle">
        {title} <br />
        <em>{titleAccent}</em>
      </h1>
      {subtitle && <p class="hero-sub">{subtitle}</p>}
      <div class="hero-actions">
        <WhatsAppLink class="button button-whatsapp" cta="hero" routeLabel={routeLabel}>
          <Icon name="chat" /> {primaryCta}
        </WhatsAppLink>
        <a class="button button-outline" href="#journey">
          Explore the itinerary <Icon name="arrow-down" size={16} />
        </a>
      </div>
      <ul class="hero-trust">
        {trust.map((t) => (
          <li>
            <Icon name={t.icon} size={26} />
            <span>
              <strong>{t.title}</strong>
              {t.text}
            </span>
          </li>
        ))}
      </ul>
    </div>
    {offer && (
      <a class="hero-offer" href={offer.href}>
        <span class="hero-offer-tag">
          <Icon name="snow" size={14} /> {offer.tag}
        </span>
        <strong class="hero-offer-title">{offer.title}</strong>
        <span class="hero-offer-trips">
          {offer.trips.map((t) => (
            <span>
              <small>{t.label}</small>
              <b>{t.price}</b>
            </span>
          ))}
        </span>
        <span class="hero-offer-note">
          {offer.note} <span aria-hidden="true">↓</span>
        </span>
      </a>
    )}
  </div>
  {place && (
    <span class="hero-place">
      <Icon name="mountain" size={14} /> {place}
    </span>
  )}
</section>
