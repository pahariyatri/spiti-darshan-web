---
import WhatsAppLink from './conversion/WhatsAppLink.astro';

const packages = [
  { duration: '6 nights / 7 days', price: '₹35,000' },
  { duration: '7 nights / 8 days', price: '₹40,000' },
];
---

<section id="winter" class="winter-spiti" aria-labelledby="winterTitle">
  <div class="shell winter-grid">
    <div class="winter-intro">
      <div class="eyebrow">Your winter escape</div>
      <h2 id="winterTitle">Experience White Spiti.</h2>
      <ul class="winter-highlights" aria-label="Winter Spiti highlights">
        <li>White Spiti</li>
        <li>Snow leopard expedition</li>
        <li>Ice Cafe Lingti</li>
        <li>Snow chain drive</li>
      </ul>
    </div>
    <div class="winter-offer">
      <div class="winter-packages">
        {packages.map((trip) => (
          <article>
            <h3>{trip.duration}</h3>
            <p>
              <strong>{trip.price}</strong> <span>Innova Crysta · car price</span>
            </p>
          </article>
        ))}
      </div>
      <p class="winter-stay">
        <strong>Homestay: ₹1,500 per person</strong> · Breakfast &amp; dinner included (MAP plan).
        Separate from the car price, for either trip.
      </p>
      <p class="winter-note">
        Winter activities depend on weather and access; wildlife sightings vary.
      </p>
      <WhatsAppLink
        class="button button-whatsapp"
        cta="page"
        routeLabel="Winter Spiti — 6 nights / 7 days or 7 nights / 8 days"
      >
        Get the full package on WhatsApp ↗
      </WhatsAppLink>
    </div>
  </div>
</section>
