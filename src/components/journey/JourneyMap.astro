---
import VehicleMarker from './VehicleMarker.astro';
import { pad2 } from '../../lib/journey/payload';

interface Props {
  path: string;
  firstLeg: string;
  firstPlace: string;
  firstStopCount: number;
  totalDays: number;
}

const { path, firstLeg, firstPlace, firstStopCount, totalDays } = Astro.props;
/* Day segments join end to end; one continuous path lets the trail's dash run the whole road. */
const trailPath = path.replace(/ M [\d.-]+ [\d.-]+(?= C)/g, '');
---

<div class="route-sticky" id="routeSticky" role="region" aria-label="Animated itinerary map">
  <div class="route-head">
    <div class="route-head-left">
      <strong id="currentLeg">{firstLeg}</strong>
      <span class="muted" id="currentPlace">
        Leaving {firstPlace}
      </span>
    </div>
    <div class="route-status">
      <span class="stop-counter" id="stopCounter">
        STOP 01 / {pad2(firstStopCount)}
      </span>
      <span class="day-counter" id="dayCounter">
        DAY 01 / {pad2(totalDays)}
      </span>
    </div>
  </div>
  <p class="sr-only" id="journeyLive" aria-live="polite" aria-atomic="true"></p>
  <div class="nav-map" id="navMap">
    <div class="map-stars" aria-hidden="true"></div>
    <div class="map-sun" aria-hidden="true"></div>
    <div class="map-moon" aria-hidden="true"></div>
    <div class="map-sky" id="mapSky" aria-hidden="true"></div>
    <div class="map-world" id="mapWorld">
      <svg
        class="route-svg"
        id="routeSvg"
        viewBox="0 0 3200 110"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <g class="road-base">
          <path class="road-casing" d={path}></path>
          <path class="road-asphalt" d={path}></path>
          <path class="road-lane" d={path}></path>
        </g>
        <path class="road-trail" id="routeTrail" d={trailPath} pathLength="1"></path>
        <path id="routePath" d={path} fill="none" stroke="none"></path>
      </svg>
      <VehicleMarker />
    </div>
  </div>
</div>
