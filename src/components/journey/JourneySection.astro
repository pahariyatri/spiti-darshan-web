---
import type { RouteView } from '../../lib/domain/types';
import { buildJourneyPayload, journeyPath } from '../../lib/journey/payload';
import JourneyMap from './JourneyMap.astro';
import JourneyDay from './JourneyDay.astro';

interface Props {
  route: RouteView;
}

const { route } = Astro.props;
const payload = buildJourneyPayload(route);
const first = payload.days[0];
---

<section class="journey" id="journey" aria-labelledby="journeyTitle">
  <h2 id="journeyTitle" class="sr-only">
    Your journey of {route.days.length} days, stop by stop
  </h2>
  <JourneyMap
    path={journeyPath(route)}
    firstLeg={first?.leg ?? route.shortTitle}
    firstPlace={route.days[0]?.stops[0]?.name ?? route.startingLocation}
    firstStopCount={first?.pins.length ?? 1}
    totalDays={route.days.length}
  />
  <div class="days" id="days">
    {route.days.map((day, i) => (
      <JourneyDay day={day} routeLabel={route.shortTitle} active={i === 0} />
    ))}
  </div>
  <script
    type="application/json"
    id="journeyData"
    set:html={JSON.stringify(payload).replace(/</g, '\\u003c')}
  ></script>
</section>

<aside id="stopCard" class="stop-card" popover="auto" aria-labelledby="stopCardTitle">
  <button type="button" id="stopCardClose" aria-label="Close place details">
    ✕
  </button>
  <span class="eyebrow">Along your route</span>
  <h2 id="stopCardTitle"></h2>
  <p id="stopCardSummary"></p>
  <a id="stopCardLink">
    Read more <span aria-hidden="true">→</span>
  </a>
</aside>

<script>
  import { initJourney } from '../../lib/journey/client';
  initJourney();
</script>
