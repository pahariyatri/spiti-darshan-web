---
import type { MediaView } from '../../lib/domain/types';
import Icon from '../Icon.astro';
import WhatsAppLink from '../conversion/WhatsAppLink.astro';
import Picture from '../Picture.astro';

interface Props {
  media: MediaView | null;
}
const { media } = Astro.props;
/* Verified service facts only — no fleet size, ratings or driver claims. */
const features = [
  {
    icon: 'seat',
    title: 'Your own car',
    text: 'An Innova Crysta for your group.',
  },
  {
    icon: 'route',
    title: 'Your kind of trip',
    text: 'Choose your stops and pace.',
  },
  {
    icon: 'shield',
    title: 'Checked for your dates',
    text: 'Seasonal road access checked before you travel.',
  },
] as const;
---

<section class="proof" aria-labelledby="proofTitle">
  <div class="shell proof-grid">
    <div class="proof-visual">
      <div class="proof-photo">
        {media && <Picture media={media} sizes="(max-width: 900px) calc(100vw - 34px), 560px" />}
        <span>Our Innova Crysta, on the real road.</span>
      </div>
      <div class="vehicle-plaque">
        <Icon name="car" size={26} />
        <div>
          <strong>Innova Crysta</strong>
          <span>Your people. Your pace.</span>
        </div>
        <span class="plaque-label">SPITI DARSHAN</span>
      </div>
    </div>
    <div class="proof-copy">
      <div class="eyebrow">Travel in comfort</div>
      <h2 id="proofTitle">
        The right car
        <br />
        <em>for higher roads.</em>
      </h2>
      <p>
        Travel with Spiti Darshan in an Innova Crysta. Your driver and route are confirmed for your
        dates.
      </p>
      <div class="proof-actions">
        <WhatsAppLink class="button button-whatsapp" cta="page">
          Get my trip plan <Icon name="chat" size={18} />
        </WhatsAppLink>
        <a class="text-link" href="/vehicles/innova-crysta/">
          Meet your ride <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="safety-note">
        Innova Crysta is not a 4×4. Winter routes and vehicle suitability are confirmed for each
        trip.
      </p>
    </div>
  </div>
  <ul class="shell proof-features">
    {features.map((f) => (
      <li>
        <span class="proof-icon">
          <Icon name={f.icon} size={26} />
        </span>
        <span>
          <strong>{f.title}</strong>
          {f.text}
        </span>
      </li>
    ))}
  </ul>
</section>
