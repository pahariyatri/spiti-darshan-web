---
import type { MediaView } from '../../lib/domain/types';
import Icon from '../Icon.astro';
import WhatsAppLink from '../conversion/WhatsAppLink.astro';
import Picture from '../Picture.astro';
import { drivers } from '../../content/team';

interface Props {
  media: MediaView | null;
  /** A second real fleet photo for the collage. */
  secondary?: MediaView | null;
  /** Show the drivers and registrations (pages with a full driver section skip this). */
  showDrivers?: boolean;
}
const { media, secondary = null, showDrivers = false } = Astro.props;
/* Verified service facts only — no fleet size, ratings or driver claims. */
const features = [
  {
    icon: 'seat',
    title: 'Your own car',
    text: 'The whole Innova Crysta is yours: your group, your luggage.',
  },
  {
    icon: 'route',
    title: 'Your kind of trip',
    text: 'Stop for monasteries, villages and photos at your pace.',
  },
  {
    icon: 'shield',
    title: 'Checked for your dates',
    text: 'Seasonal road access checked before you travel.',
  },
] as const;
---

<section class="proof" aria-labelledby="proofTitle">
  <span class="proof-watermark" aria-hidden="true">
    Innova Crysta
  </span>
  <div class="shell proof-grid">
    <div class="proof-visual">
      <div class="proof-photo">
        {media && <Picture media={media} sizes="(max-width: 900px) calc(100vw - 40px), 520px" />}
        <span class="proof-badge">
          <Icon name="check" size={14} /> Real photo · Our fleet in Spiti
        </span>
      </div>
      {secondary && (
        <div class="proof-photo-2">
          <Picture media={secondary} sizes="(max-width: 600px) 55vw, 300px" />
        </div>
      )}
      <div class="vehicle-plate" aria-hidden="true">
        <span>HP</span>
        <strong>SPITI DARSHAN</strong>
      </div>
    </div>
    <div class="proof-copy">
      <div class="eyebrow">The real vehicle</div>
      <h2 id="proofTitle">
        The right car
        <br />
        <em>for higher roads.</em>
      </h2>
      <p>
        No stock photos. This is our Innova Crysta on the Spiti road, with a driver for your group
        and a route confirmed for your dates.
      </p>
      <ul class="proof-features">
        {features.map((f) => (
          <li>
            <span class="proof-icon">
              <Icon name={f.icon} size={22} />
            </span>
            <span>
              <strong>{f.title}</strong>
              {f.text}
            </span>
          </li>
        ))}
      </ul>
      {showDrivers && (
        <div class="proof-drivers">
          <h3>Your drivers &amp; cars</h3>
          <ul>
            {drivers.map((d) => (
              <li>
                <span class="driver-avatar" aria-hidden="true">
                  {d.name.charAt(0)}
                </span>
                <span class="driver-name">
                  <strong>{d.name}</strong>
                  {d.vehicle}
                </span>
                <span class="plate">
                  <b aria-hidden="true">IND</b>
                  <span class="sr-only">Registration</span>
                  {d.registration}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
      <div class="proof-actions">
        <WhatsAppLink class="button button-whatsapp" cta="page">
          <Icon name="chat" size={18} /> Get my trip plan
        </WhatsAppLink>
        <a class="text-link" href="/vehicles/innova-crysta/">
          Meet your ride <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="safety-note">
        Innova Crysta is not a 4×4. Winter routes and vehicle suitability are confirmed for each
        trip.
      </p>
    </div>
  </div>
</section>
