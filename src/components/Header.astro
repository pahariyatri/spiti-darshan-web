---
import { SITE } from '../lib/config/site';
import Icon from './Icon.astro';
import WhatsAppLink from './conversion/WhatsAppLink.astro';

interface Props {
  routeLabel?: string | null;
  homeHref?: string;
}
const { routeLabel, homeHref = '/' } = Astro.props;
const nav = [
  { href: '/#journey', label: 'Itinerary' },
  { href: '/routes/', label: 'Routes' },
  { href: '/spiti-road-guide/', label: 'Road guide' },
  { href: '/vehicles/innova-crysta/', label: 'Innova Crysta' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="header">
  <div class="shell header-inner">
    <a class="brand" href={homeHref}>
      <span class="brand-mark">{SITE.brandMark}</span>
      <span>
        <strong>{SITE.name}</strong>
        <small>{SITE.tagline}</small>
      </span>
    </a>
    <nav class="header-nav" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href}>{n.label}</a>
      ))}
    </nav>
    <WhatsAppLink class="button button-whatsapp header-book" cta="header" routeLabel={routeLabel}>
      <Icon name="chat" size={16} />{' '}
      <span>
        Chat<span class="header-book-extra"> to book</span>
      </span>
    </WhatsAppLink>
  </div>
</header>
