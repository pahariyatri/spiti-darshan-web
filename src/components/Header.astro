---
import Icon from './Icon.astro';
import WhatsAppLink from './conversion/WhatsAppLink.astro';

interface Props {
  routeLabel?: string | null;
  homeHref?: string;
}
const { routeLabel, homeHref = '/' } = Astro.props;
const nav = [
  { href: '/#journey', label: 'Itinerary' },
  { href: '/routes/', label: 'Routes' },
  { href: '/spiti-road-guide/', label: 'Road guide' },
  { href: '/vehicles/innova-crysta/', label: 'Innova Crysta' },
  { href: '/about/', label: 'Our story' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="header">
  <div class="shell header-inner">
    <a class="brand brand-logo" href={homeHref} aria-label="Spiti Darshan home">
      <img src="/brand/spiti-darshan-mark.webp" width="56" height="56" alt="" decoding="async" />
      <span class="brand-wordmark" aria-hidden="true">
        <span>Spiti</span>
        <span>Darshan</span>
      </span>
    </a>
    <nav class="header-nav" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href}>{n.label}</a>
      ))}
    </nav>
    <WhatsAppLink
      class="button button-whatsapp header-book"
      aria-label="Chat on WhatsApp"
      cta="header"
      routeLabel={routeLabel}
    >
      <Icon name="chat" size={16} />{' '}
      <span>
        Chat<span class="header-book-extra"> to book</span>
      </span>
    </WhatsAppLink>
  </div>
</header>
