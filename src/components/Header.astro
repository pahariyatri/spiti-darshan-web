---
import Icon from './Icon.astro';
import WhatsAppLink from './conversion/WhatsAppLink.astro';

interface Props {
  routeLabel?: string | null;
  homeHref?: string;
}
const { routeLabel, homeHref = '/' } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/#winter', label: 'Winter Spiti' },
  { href: '/#journey', label: 'Itinerary' },
  { href: '/vehicles/innova-crysta/', label: 'Innova Crysta' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="header">
  <div class="shell header-inner">
    <a class="brand brand-logo" href={homeHref} aria-label="Spiti Darshan home">
      <img src="/brand/spiti-darshan-mark.webp" width="56" height="56" alt="" decoding="async" />
      <span class="brand-wordmark" aria-hidden="true">
        <span>Spiti</span>
        <span>Darshan</span>
      </span>
    </a>
    <nav class="header-nav" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={currentPath === n.href ? 'page' : undefined}>
          {n.label}
        </a>
      ))}
    </nav>
    <WhatsAppLink
      class="button button-whatsapp header-book"
      aria-label="Chat on WhatsApp"
      cta="header"
      routeLabel={routeLabel}
    >
      <Icon name="chat" size={16} />{' '}
      <span>
        Chat<span class="header-book-extra"> to book</span>
      </span>
    </WhatsAppLink>
    <details class="mobile-menu">
      <summary aria-label="Navigation menu">
        <span class="menu-lines" aria-hidden="true"></span>
        <span>Menu</span>
      </summary>
      <nav aria-label="Mobile navigation">
        {nav.map((n) => (
          <a href={n.href} aria-current={currentPath === n.href ? 'page' : undefined}>
            {n.label}
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menu) {
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>
