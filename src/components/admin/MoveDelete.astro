---
/* Up / down / delete buttons, each its own tiny form (works without JavaScript). */
import { actions } from 'astro:actions';

interface Props {
  id: number;
  kind: 'day' | 'stop';
  returnTo: string;
  confirm: string;
}
const { id, kind, returnTo, confirm } = Astro.props;
const move = kind === 'day' ? actions.moveDay : actions.moveStop;
const del = kind === 'day' ? actions.deleteDay : actions.deleteStop;
---

<div class="row-actions">
  <form class="inline" method="POST" action={returnTo + move}>
    <input type="hidden" name="id" value={id} />
    <input type="hidden" name="direction" value="up" />
    <button class="btn small secondary" type="submit" aria-label={`Move ${kind} up`}>
      ↑
    </button>
  </form>
  <form class="inline" method="POST" action={returnTo + move}>
    <input type="hidden" name="id" value={id} />
    <input type="hidden" name="direction" value="down" />
    <button class="btn small secondary" type="submit" aria-label={`Move ${kind} down`}>
      ↓
    </button>
  </form>
  <details class="inline">
    <summary class="btn small danger">Delete</summary>
    <form method="POST" action={returnTo + del}>
      <input type="hidden" name="id" value={id} />
      <p>{confirm}</p>
      <button class="btn small danger" type="submit">
        Yes, delete
      </button>
    </form>
  </details>
</div>
