}
const { name, size = 18 } = Astro.props;
const paths: Record<Props['name'], string> = {
  chat: '<path d="M12 3.2a8.6 8.6 0 0 0-7.4 13l-1.2 4.2 4.3-1.1A8.6 8.6 0 1 0 12 3.2Z"/><path d="M9 8.6c.3-.6.6-.6.9-.6h.5c.2 0 .4 0 .6.4l.8 1.8c.1.3 0 .5-.1.7l-.5.6c-.2.2-.2.4 0 .7a6.4 6.4 0 0 0 2.7 2.4c.3.1.5.1.7-.1l.6-.8c.2-.2.4-.3.7-.2l1.8.8c.3.2.4.3.4.5 0 .6-.3 1.4-1 1.8-.6.4-1.7.6-3.5-.2a10.7 10.7 0 0 1-4.6-4.1c-.8-1.4-.8-2.6-.4-3.4Z"/>',
