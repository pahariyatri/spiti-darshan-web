  snow: '<path d="M12 2.5v19M3.8 7.25l16.4 9.5M3.8 16.75l16.4-9.5"/><path d="m9.5 4 2.5 2.5L14.5 4m-5 16 2.5-2.5 2.5 2.5M4.6 10.3l3.4.9-.9 3.4m12.3-4.3-3.4.9.9 3.4"/>',
  paw: '<ellipse cx="12" cy="16" rx="4.2" ry="3.6"/><circle cx="6" cy="11" r="1.8"/><circle cx="9.3" cy="6.6" r="1.8"/><circle cx="14.7" cy="6.6" r="1.8"/><circle cx="18" cy="11" r="1.8"/>',
