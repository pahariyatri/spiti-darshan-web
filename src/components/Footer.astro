---
import { SITE } from '../lib/config/site';
import { businessWhatsApp } from '../lib/config/env';
import WhatsAppLink from './conversion/WhatsAppLink.astro';
const year = new Date().getFullYear();
const number = businessWhatsApp();
---

<footer class="footer">
  <div class="shell footer-inner">
    <span>
      © <span id="year">{year}</span> {SITE.name} · {SITE.footerTagline}
    </span>
    <span>
      WhatsApp <WhatsAppLink cta="page">{number.display}</WhatsAppLink>
    </span>
    <nav class="footer-nav" aria-label="Site">
      <a href="/routes/">Routes</a>
      <a href="/places/">Places</a>
      <a href="/spiti-road-guide/">Road guide</a>
      <a href="/vehicles/innova-crysta/">Innova Crysta</a>
      <a href="/contact/">Contact</a>
      <a href="/about/">About</a>
    </nav>
    <span>
      Illustrated journey, not live navigation. Check{' '}
      <a href={SITE.officialRouteGuidance.url} target="_blank" rel="noopener">
        {SITE.officialRouteGuidance.label}
      </a>{' '}
      before travel.
    </span>
  </div>
</footer>
