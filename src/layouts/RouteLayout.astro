---
/**
 * The one route template. The homepage and every /routes/[slug]/ page render through here —
 * adding a route is content, never a copied page.
 */
import BaseLayout from './BaseLayout.astro';
import WinterSpiti from '../components/WinterSpiti.astro';
import Hero from '../components/Hero.astro';
import JourneySection from '../components/journey/JourneySection.astro';
import RouteFacts from '../components/RouteFacts.astro';
import DriverIntro from '../components/team/DriverIntro.astro';
import VehicleProof from '../components/vehicles/VehicleProof.astro';
import ContactSection from '../components/conversion/ContactSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import MobileWhatsAppCTA from '../components/conversion/MobileWhatsAppCTA.astro';
import type { RouteView } from '../lib/domain/types';
import type { PageMeta } from '../lib/seo/meta';
import type { ComponentProps } from 'astro/types';
import { staticMedia, toMediaView } from '../lib/media/static-media';

interface Props {
  route: RouteView;
  meta: PageMeta;
  jsonLd?: unknown;
  /** Homepage keeps the brand hero copy and hides the route-facts block (approved layout). */
  variant: 'home' | 'route';
  hero?: Partial<RouteView['hero']>;
  primaryCta?: string;
  heroOffer?: ComponentProps<typeof Hero>['offer'];
  heroPlace?: string | null;
}

const {
  route,
  meta,
  jsonLd,
  variant,
  hero: heroOverride,
  primaryCta,
  heroOffer = null,
  heroPlace = null,
} = Astro.props;
const hero = { ...route.hero, ...heroOverride };
const proofMedia = route.vehicles.find((v) => v.media)?.media ?? null;
const proofSecondary = toMediaView(staticMedia('hero-vehicles'));
---

<BaseLayout meta={meta} jsonLd={jsonLd} preload={hero.media}>
  <Hero
    kicker={hero.kicker}
    title={hero.title}
    titleAccent={hero.titleAccent}
    subtitle={hero.subtitle}
    media={hero.media}
    routeLabel={variant === 'home' ? 'Winter Spiti' : route.shortTitle}
    primaryCta={primaryCta}
    offer={heroOffer}
    place={heroPlace}
  />
  <main id="main">
    {variant === 'home' && <WinterSpiti />}
    <JourneySection route={route} />
    {variant !== 'home' && <RouteFacts route={route} />}
    <VehicleProof media={proofMedia} secondary={proofSecondary} showDrivers={variant === 'home'} />
    {variant !== 'home' && <DriverIntro />}
    <FaqSection />
    <ContactSection routeLabel={variant === 'home' ? 'Winter Spiti' : route.shortTitle} />
  </main>
  <Footer />
  <MobileWhatsAppCTA routeLabel={variant === 'home' ? 'Winter Spiti' : route.shortTitle} />
</BaseLayout>
