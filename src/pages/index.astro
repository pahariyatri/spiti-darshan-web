---
/* Homepage: the brand hero over the featured route's itinerary (src/content/routes). */
import { staticMedia, toMediaView } from '../lib/media/static-media';
import RouteLayout from '../layouts/RouteLayout.astro';
import { buildPageMeta } from '../lib/seo/meta';
import {
  graph,
  organizationSchema,
  touristTripSchema,
  webPageSchema,
  winterTripSchema,
} from '../lib/seo/schema';
import { HOME, WINTER_TRIPS } from '../lib/home';
import { getFeaturedRoute } from '../lib/content/routes';

const route = getFeaturedRoute();
const homeHero = { ...HOME.hero, media: toMediaView(staticMedia('day-key-monastery')) };
const site = Astro.site ?? Astro.url;
const meta = buildPageMeta({
  title: HOME.title,
  description: HOME.description,
  path: '/',
  site,
  ogTitle: HOME.ogTitle,
  ogDescription: HOME.ogDescription,
  ogImage: homeHero.media,
});
const jsonLd = graph(
  organizationSchema(site),
  webPageSchema({ name: HOME.title, description: HOME.description, url: meta.canonical, site }),
  winterTripSchema(WINTER_TRIPS, site),
  touristTripSchema(route, site),
);
---

<RouteLayout
  route={route}
  meta={meta}
  jsonLd={jsonLd}
  variant="home"
  hero={homeHero}
  primaryCta={HOME.primaryCta}
  heroOffer={HOME.heroOffer}
  heroPlace={HOME.heroPlace}
/>
