---
/**
 * Homepage — prerendered at build time from the featured published route. The build fails loudly
 * if there is none (no silent fallback content). Edits to the featured route appear on /routes/…
 * immediately and on the homepage at the next deploy.
 */
import RouteLayout from '../layouts/RouteLayout.astro';
import { buildPageMeta } from '../lib/seo/meta';
import { graph, organizationSchema, touristTripSchema, webPageSchema } from '../lib/seo/schema';
import { HOME } from '../lib/home';
import { findFeaturedRoute } from '../lib/repositories/routes';

export const prerender = true;

const route = await findFeaturedRoute();
if (!route) {
  throw new Error(
    'Homepage build: no published featured route. Run `pnpm db:seed` or feature a route in /admin.',
  );
}
const site = Astro.site ?? Astro.url;
const meta = buildPageMeta({
  title: HOME.title,
  description: HOME.description,
  path: '/',
  site,
  ogTitle: HOME.ogTitle,
  ogDescription: HOME.ogDescription,
  ogImage: route.hero.media,
});
const jsonLd = graph(
  organizationSchema(site),
  webPageSchema({ name: HOME.title, description: HOME.description, url: meta.canonical, site }),
  touristTripSchema(route, site),
);
---

<RouteLayout route={route} meta={meta} jsonLd={jsonLd} variant="home" hero={HOME.hero} />
