---
/* Rendered for unhandled server errors (e.g. database unavailable). Must not touch the DB. */
import PageLayout from '../layouts/PageLayout.astro';
import WhatsAppLink from '../components/conversion/WhatsAppLink.astro';
import { buildPageMeta, NOINDEX } from '../lib/seo/meta';

const meta = buildPageMeta({
  title: 'Temporarily unavailable',
  description:
    'This page is temporarily unavailable. You can still message Spiti Darshan on WhatsApp.',
  path: '/500/',
  site: Astro.site ?? Astro.url,
  robots: NOINDEX,
});
Astro.response.headers.set('Cache-Control', 'no-store');
---

<PageLayout
  meta={meta}
  eyebrow="Temporarily unavailable"
  title="We hit a bump in the road."
  titleAccent="WhatsApp still works."
>
  <div class="shell prose">
    <p>
      Please try again in a minute. If you are planning a trip, message us your dates and group size
      directly.
    </p>
    <p class="hero-actions">
      <WhatsAppLink class="button button-whatsapp" cta="page">
        Start WhatsApp conversation ↗
      </WhatsAppLink>
    </p>
  </div>
</PageLayout>
