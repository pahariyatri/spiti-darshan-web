---
import PageLayout from '../layouts/PageLayout.astro';
import WhatsAppLink from '../components/conversion/WhatsAppLink.astro';
import DriverIntro from '../components/team/DriverIntro.astro';
import { foundersStory } from '../content/team';
import { buildPageMeta } from '../lib/seo/meta';
import { breadcrumbSchema, graph, organizationSchema, webPageSchema } from '../lib/seo/schema';
const site = Astro.site ?? Astro.url;
const meta = buildPageMeta({
  title: 'Our story and the people behind Spiti Darshan',
  description:
    'Three friends became like brothers and started Spiti Darshan together. Read our story and learn about the people behind your private Spiti road journey.',
  path: '/about/',
  site,
});
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Our story', path: '/about/' },
];
const jsonLd = graph(
  organizationSchema(site),
  {
    ...webPageSchema({
      name: meta.title,
      description: meta.description,
      url: meta.canonical,
      site,
    }),
    '@type': 'AboutPage',
  },
  breadcrumbSchema(crumbs, site),
);
---

<PageLayout
  meta={meta}
  jsonLd={jsonLd}
  eyebrow="The people behind Spiti Darshan"
  title="Three friends."
  titleAccent="One shared journey."
  intro={foundersStory.intro}
  breadcrumbs={crumbs}
>
  <section class="shell founder-story" aria-labelledby="founderTitle">
    <div class="founder-note">
      <span class="eyebrow">Our beginning</span>
      <p>
        Friends first.
        <br />
        Family in spirit.
      </p>
      <span>Built together at Spiti Darshan.</span>
    </div>
    <div class="prose">
      <h2 id="founderTitle">{foundersStory.title}</h2>
      {foundersStory.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p>
        <a href="/routes/">Explore our journeys →</a>
      </p>
    </div>
  </section>
  <DriverIntro showStory={false} />
  <section class="shell about-invite" aria-labelledby="inviteTitle">
    <h2 id="inviteTitle">Let’s talk about your journey.</h2>
    <p>
      Share your dates, group size and the places you want to see. We can discuss the route, vehicle
      and driver together.
    </p>
    <WhatsAppLink class="button button-whatsapp" cta="page">
      Chat with our team ↗
    </WhatsAppLink>
  </section>
</PageLayout>
