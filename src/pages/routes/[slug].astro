---
/* One static page per published route in src/content/routes — all through the same template. */
import type { GetStaticPaths } from 'astro';
import RouteLayout from '../../layouts/RouteLayout.astro';
import { buildRouteMeta, routePath } from '../../lib/seo/meta';
import {
  breadcrumbSchema,
  graph,
  organizationSchema,
  touristTripSchema,
  webPageSchema,
} from '../../lib/seo/schema';
import { getPublishedRoutes } from '../../lib/content/routes';
import type { RouteView } from '../../lib/domain/types';

export const getStaticPaths = (() =>
  getPublishedRoutes().map((route) => ({
    params: { slug: route.slug },
    props: { route },
  }))) satisfies GetStaticPaths;

interface Props {
  route: RouteView;
}
const { route } = Astro.props;
const site = Astro.site ?? Astro.url;
const meta = buildRouteMeta(route, site);
const jsonLd = graph(
  organizationSchema(site),
  webPageSchema({ name: meta.title, description: meta.description, url: meta.canonical, site }),
  touristTripSchema(route, site, meta.canonical),
  breadcrumbSchema(
    [
      { name: 'Home', path: '/' },
      { name: 'Routes', path: '/routes/' },
      { name: route.shortTitle, path: routePath(route.slug) },
    ],
    site,
  ),
);
---

<RouteLayout route={route} meta={meta} jsonLd={jsonLd} variant="route" />
