---
import PageLayout from '../../layouts/PageLayout.astro';
import { buildPageMeta, routePath } from '../../lib/seo/meta';
import { breadcrumbSchema, graph, organizationSchema, webPageSchema } from '../../lib/seo/schema';
import { listPublishedRoutes } from '../../lib/repositories/routes';
import { publicPageCache } from '../../lib/http/cache';

export const prerender = false;

const routes = await listPublishedRoutes();
const site = Astro.site ?? Astro.url;
const meta = buildPageMeta({
  title: 'Private Spiti taxi routes',
  description:
    'Day-wise private taxi routes for Spiti Valley by Innova Crysta. See each itinerary, seasonal sections and overnight stops, then check your dates on WhatsApp.',
  path: '/routes/',
  site,
});
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Routes', path: '/routes/' },
];
const jsonLd = graph(
  organizationSchema(site),
  webPageSchema({ name: meta.title, description: meta.description, url: meta.canonical, site }),
  breadcrumbSchema(crumbs, site),
);
publicPageCache(Astro.response.headers);
---

<PageLayout
  meta={meta}
  jsonLd={jsonLd}
  eyebrow="Private Spiti transport"
  title="Choose your road."
  titleAccent="Every route, day by day."
  breadcrumbs={crumbs}
>
  <div class="shell">
    <ul class="route-cards">
      {routes.map((r) => (
        <li>
          <a href={routePath(r.slug)}>
            <div class="eyebrow">
              {r.durationDays} days · {r.startingLocation} → {r.endingLocation}
            </div>
            <strong>{r.shortTitle}</strong>
            <span>{r.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</PageLayout>
