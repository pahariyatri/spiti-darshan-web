---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listRoutesForAdmin } from '../../lib/services/admin';
import { leadSummary } from '../../lib/repositories/leads';

export const prerender = false;

const [routes, leads] = await Promise.all([listRoutesForAdmin(), leadSummary(30)]);
const total = (t: string) => leads.byType.find((r) => r.eventType === t)?.total ?? 0;
---

<AdminLayout title="Dashboard" section="dashboard">
  <h2>Routes</h2>
  <p>
    <a class="btn" href="/admin/routes/new/">
      + New route
    </a>
  </p>
  <table>
    <thead>
      <tr>
        <th>Route</th>
        <th>Status</th>
        <th>Days</th>
        <th>Updated</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {routes.map((r) => (
        <tr>
          <td>
            <a href={`/admin/routes/${r.id}/`}>{r.name}</a>
            {r.isFeatured && <span class="pill">homepage</span>}
            <br />
            <span class="muted">/routes/{r.slug}/</span>
          </td>
          <td>
            <span class:list={['pill', r.status]}>{r.status}</span>
          </td>
          <td>{r.durationDays}</td>
          <td>{r.updatedAt.toISOString().slice(0, 16).replace('T', ' ')}</td>
          <td class="row-actions">
            <a href={`/admin/routes/${r.id}/preview/`}>Preview</a>
            {r.status === 'published' && (
              <a href={`/routes/${r.slug}/`} target="_blank" rel="noopener">
                Live ↗
              </a>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Enquiry intent — last 30 days</h2>
  <p class="muted">
    Clicks and views are <strong>intent</strong>, not bookings. Track qualified WhatsApp enquiries,
    quotes sent and confirmed bookings separately (see README → Analytics).
  </p>
  <div class="grid">
    <div class="card">
      <strong>{total('whatsapp_click')}</strong>
      <br />
      WhatsApp clicks
    </div>
    <div class="card">
      <strong>{total('route_view')}</strong>
      <br />
      Route views (JS beacons)
    </div>
    <div class="card">
      <strong>{total('route_day_interest')}</strong>
      <br />
      Day-stop taps
    </div>
  </div>
  <div class="grid">
    <div>
      <h2>Clicks by CTA</h2>
      <table>
        <tbody>
          {leads.byCta.map((r) => (
            <tr>
              <td>{r.cta ?? '—'}</td>
              <td>{r.total}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div>
      <h2>Clicks by source</h2>
      <table>
        <tbody>
          {leads.bySource.map((r) => (
            <tr>
              <td>{r.source}</td>
              <td>{r.total}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
