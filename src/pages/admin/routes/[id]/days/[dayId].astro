---
import { actions } from 'astro:actions';
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import Field from '../../../../../components/admin/Field.astro';
import Select from '../../../../../components/admin/Select.astro';
import Check from '../../../../../components/admin/Check.astro';
import MoveDelete from '../../../../../components/admin/MoveDelete.astro';
import { feedbackFrom } from '../../../../../lib/admin/feedback';
import { getDayForEdit, listMedia, listPlaces } from '../../../../../lib/services/admin';
import { STOP_TYPES } from '../../../../../lib/domain/types';

export const prerender = false;

const routeId = Number(Astro.params.id);
const dayId = Number(Astro.params.dayId);
if (![routeId, dayId].every((n) => Number.isInteger(n) && n > 0))
  return new Response(null, { status: 404 });
const self = `/admin/routes/${routeId}/days/${dayId}/`;

const results = [
  Astro.getActionResult(actions.updateDay),
  Astro.getActionResult(actions.addStop),
  Astro.getActionResult(actions.updateStop),
  Astro.getActionResult(actions.moveStop),
  Astro.getActionResult(actions.deleteStop),
];
const fb = feedbackFrom(results);
if (fb.ok) return Astro.redirect(`${self}?saved=1`, 303);

const [day, media, places] = await Promise.all([
  getDayForEdit(routeId, dayId),
  listMedia(),
  listPlaces(),
]);
if (!day) return new Response(null, { status: 404 });
const mediaOptions = media.map((m) => ({ value: m.id, label: `${m.alt} (${m.basePath})` }));
const destOptions = places.destinations.map((d) => ({ value: d.id, label: d.name }));
const attrOptions = places.attractions.map((a) => ({ value: a.id, label: a.name }));
const typeOptions = STOP_TYPES.map((t) => ({ value: t, label: t }));
const err = fb.fields;
---

<AdminLayout title={`Day ${day.dayNumber}: ${day.title}`} section="routes" feedback={fb}>
  <p>
    <a href={`/admin/routes/${routeId}/`}>← {day.route.name}</a>
  </p>

  <h2>Stops (in order)</h2>
  <p class="muted">
    Every stop becomes a tappable chip under the day. Stops "on the map" become pins along the day's
    road. Tick
    <em>optional</em> for detours (shown as “· optional”) and <em>seasonal</em> for sections that
    depend on road access.
  </p>
  {day.stops.map((st) => (
    <details class="card">
      <summary>
        <strong>{st.stopName}</strong> <span class="pill">{st.stopType}</span>
        {st.isOptional && <span class="pill">optional</span>}
        {st.isSeasonal && <span class="pill">seasonal</span>}
        {!st.showOnMap && <span class="pill">chip only</span>}
      </summary>
      <form method="POST" action={self + actions.updateStop}>
        <input type="hidden" name="id" value={st.id} />
        <div class="grid">
          <Field name="stopName" label="Name" value={st.stopName} required maxlength={80} />
          <Field
            name="mapLabel"
            label="Map label override"
            value={st.mapLabel}
            maxlength={80}
            hint="e.g. Kaza · return"
          />
          <Select name="stopType" label="Type" options={typeOptions} value={st.stopType} />
          <Select
            name="destinationId"
            label="Destination"
            options={destOptions}
            value={st.destinationId}
            empty="—"
          />
          <Select
            name="attractionId"
            label="Attraction"
            options={attrOptions}
            value={st.attractionId}
            empty="—"
          />
          <Check name="isOptional" label="Optional" checked={st.isOptional} />
          <Check name="isSeasonal" label="Seasonal" checked={st.isSeasonal} />
          <Check name="showOnMap" label="Show on map" checked={st.showOnMap} />
        </div>
        <p>
          <button class="btn small" type="submit">
            Save stop
          </button>
        </p>
      </form>
      <MoveDelete id={st.id} kind="stop" returnTo={self} confirm={`Delete “${st.stopName}”?`} />
    </details>
  ))}

  <form class="card" method="POST" action={self + actions.addStop}>
    <strong>+ Add a stop</strong>
    <input type="hidden" name="dayId" value={day.id} />
    <div class="grid">
      <Field name="stopName" label="Name" required maxlength={80} errors={err.stopName} />
      <Field name="mapLabel" label="Map label override" maxlength={80} />
      <Select name="stopType" label="Type" options={typeOptions} value="stop" />
      <Select
        name="destinationId"
        label="Destination"
        options={destOptions}
        empty="—"
        hint="Add new places on the Places page"
      />
      <Select name="attractionId" label="Attraction" options={attrOptions} empty="—" />
      <Check name="isOptional" label="Optional" />
      <Check name="isSeasonal" label="Seasonal" />
      <Check name="showOnMap" label="Show on map" checked />
    </div>
    <p>
      <button class="btn" type="submit">
        Add stop
      </button>
    </p>
  </form>

  <h2>Day details</h2>
  <form class="card" method="POST" action={self + actions.updateDay}>
    <input type="hidden" name="id" value={day.id} />
    <div class="grid">
      <Field
        name="title"
        label="Title"
        value={day.title}
        required
        maxlength={120}
        errors={err.title}
      />
      <Field name="subtitle" label="Eyebrow" value={day.subtitle} maxlength={80} />
      <Field name="mapLegLabel" label="Map leg label" value={day.mapLegLabel} maxlength={80} />
      <Select
        name="overnightDestinationId"
        label="Overnight"
        options={destOptions}
        value={day.overnightDestinationId}
        empty="—"
      />
      <Select name="mediaId" label="Photo" options={mediaOptions} value={day.mediaId} empty="—" />
      <Field
        name="shortDescription"
        label="One-line hook"
        value={day.shortDescription}
        maxlength={300}
        wide
      />
      <Field name="dayNote" label="Note" type="textarea" value={day.dayNote} maxlength={400} wide />
      <Field
        name="mapSegment"
        label="Map road segment (SVG path, advanced)"
        type="textarea"
        value={day.mapSegment}
        maxlength={4000}
        wide
        errors={err.mapSegment}
        hint="Leave empty to generate a road automatically. ViewBox is 3200×110; start where the previous day ended."
      />
      <Check name="isSeasonal" label="Seasonal day" checked={day.isSeasonal} />
    </div>
    <p>
      <button class="btn" type="submit">
        Save day
      </button>
    </p>
  </form>
</AdminLayout>
