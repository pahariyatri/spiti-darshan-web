---
import { actions } from 'astro:actions';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import Field from '../../../../components/admin/Field.astro';
import Select from '../../../../components/admin/Select.astro';
import Check from '../../../../components/admin/Check.astro';
import MoveDelete from '../../../../components/admin/MoveDelete.astro';
import { feedbackFrom } from '../../../../lib/admin/feedback';
import {
  getRouteForEdit,
  listMedia,
  listPlaces,
  listVehicles,
} from '../../../../lib/services/admin';

export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return new Response(null, { status: 404 });
const self = `/admin/routes/${id}/`;

const results = {
  update: Astro.getActionResult(actions.updateRoute),
  status: Astro.getActionResult(actions.setRouteStatus),
  addDay: Astro.getActionResult(actions.addDay),
  moveDay: Astro.getActionResult(actions.moveDay),
  deleteDay: Astro.getActionResult(actions.deleteDay),
};
if (results.addDay?.data)
  return Astro.redirect(`${self}days/${results.addDay.data.id}/?saved=1`, 303);
const fb = feedbackFrom(Object.values(results));
if (fb.ok) return Astro.redirect(`${self}?saved=1`, 303);

const [data, media, vehicles, places] = await Promise.all([
  getRouteForEdit(id),
  listMedia(),
  listVehicles(),
  listPlaces(),
]);
if (!data) return new Response(null, { status: 404 });
const { route, seo } = data;
const mediaOptions = media.map((m) => ({ value: m.id, label: `${m.alt} (${m.basePath})` }));
const destOptions = places.destinations.map((d) => ({ value: d.id, label: d.name }));
const routeVehicleIds = new Set(route.vehicles.map((v) => v.vehicleId));
const err = fb.fields;
---

<AdminLayout title={route.name} section="routes" feedback={fb}>
  <div class="card">
    <p>
      Status: <span class:list={['pill', route.status]}>{route.status}</span>
      {route.isFeatured && <span class="pill">homepage route</span>} · URL:{' '}
      <code>/routes/{route.slug}/</code> ·<a href={`${self}preview/`}>Preview</a>
    </p>
    <div class="row-actions">
      {(['published', 'draft', 'archived'] as const)
        .filter((s) => s !== route.status)
        .map((s) => (
          <form class="inline" method="POST" action={self + actions.setRouteStatus}>
            <input type="hidden" name="id" value={route.id} />
            <input type="hidden" name="status" value={s} />
            <button class:list={['btn', 'small', { secondary: s !== 'published' }]} type="submit">
              {s === 'published' ? 'Publish' : s === 'draft' ? 'Unpublish (draft)' : 'Archive'}
            </button>
          </form>
        ))}
    </div>
    {route.isFeatured && (
      <p class="muted">
        The homepage is prerendered: changes to this route appear on / after the next deploy (they
        are live on /routes/{route.slug}/ immediately).
      </p>
    )}
  </div>

  <h2>Days</h2>
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Day</th>
        <th>Stops</th>
        <th>Overnight</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {route.days.map((d) => (
        <tr>
          <td>{d.dayNumber}</td>
          <td>
            <a href={`${self}days/${d.id}/`}>{d.title}</a>
            {d.isSeasonal && <span class="pill">seasonal</span>}
            <br />
            <span class="muted">{d.subtitle}</span>
          </td>
          <td>
            {d.stops.map((st) => st.stopName + (st.isOptional ? ' (optional)' : '')).join(' → ')}
          </td>
          <td>{d.overnight?.name ?? '—'}</td>
          <td>
            <MoveDelete
              id={d.id}
              kind="day"
              returnTo={self}
              confirm={`Delete day ${d.dayNumber} and its stops? Later days are renumbered.`}
            />
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <details class="card" open={route.days.length === 0}>
    <summary>
      <strong>+ Add a day</strong>
    </summary>
    <form method="POST" action={self + actions.addDay}>
      <input type="hidden" name="routeId" value={route.id} />
      <div class="grid">
        <Field
          name="title"
          label="Title (e.g. Shimla → Sangla)"
          required
          maxlength={120}
          errors={err.title}
        />
        <Field name="subtitle" label="Eyebrow (e.g. The first climb)" maxlength={80} />
        <Field
          name="mapLegLabel"
          label="Map leg label"
          maxlength={80}
          hint="Defaults to the title"
        />
        <Select name="overnightDestinationId" label="Overnight" options={destOptions} empty="—" />
        <Select name="mediaId" label="Photo" options={mediaOptions} empty="—" />
        <Field name="shortDescription" label="One-line hook" maxlength={300} wide />
        <Field
          name="dayNote"
          label="Note (seasonal/optional qualifiers, overnight)"
          type="textarea"
          maxlength={400}
          wide
        />
        <Check name="isSeasonal" label="Seasonal day" />
      </div>
      <p>
        <button class="btn" type="submit">
          Add day
        </button>
      </p>
    </form>
  </details>

  <h2>Route details & SEO</h2>
  <form class="card" method="POST" action={self + actions.updateRoute}>
    <input type="hidden" name="id" value={route.id} />
    <div class="grid">
      <Field
        name="name"
        label="Route name"
        value={route.name}
        required
        maxlength={160}
        errors={err.name}
      />
      <Field
        name="shortTitle"
        label="Short title"
        value={route.shortTitle}
        required
        maxlength={80}
        errors={err.shortTitle}
      />
      <Field
        name="slug"
        label="URL slug"
        value={route.slug}
        required
        maxlength={80}
        errors={err.slug}
        hint="Changing a published slug breaks existing links."
      />
      <Field
        name="routeType"
        label="Route type"
        value={route.routeType}
        required
        maxlength={40}
        hint="circuit, one-way, local…"
      />
      <Field
        name="startingLocation"
        label="Starts at"
        value={route.startingLocation}
        required
        errors={err.startingLocation}
      />
      <Field
        name="endingLocation"
        label="Ends at"
        value={route.endingLocation}
        required
        errors={err.endingLocation}
      />
      <Field
        name="summary"
        label="Summary"
        type="textarea"
        value={route.summary}
        required
        maxlength={600}
        wide
        errors={err.summary}
      />
      <Field
        name="seasonality"
        label="Seasonality"
        type="textarea"
        value={route.seasonality}
        maxlength={800}
        wide
      />
      <Field name="heroKicker" label="Hero kicker" value={route.heroKicker} maxlength={80} />
      <Field
        name="heroTitle"
        label="Hero title (H1 line 1)"
        value={route.heroTitle}
        maxlength={120}
      />
      <Field
        name="heroTitleAccent"
        label="Hero accent (H1 line 2)"
        value={route.heroTitleAccent}
        maxlength={120}
      />
      <Select
        name="heroMediaId"
        label="Hero image"
        options={mediaOptions}
        value={route.heroMediaId}
        empty="—"
      />
      <Check name="isFeatured" label="Homepage route (only one)" checked={route.isFeatured} />
    </div>
    <fieldset class="card">
      <legend>Vehicles on this route</legend>
      {vehicles.map((v) => (
        <label class="check">
          <input
            type="checkbox"
            name="vehicleIds"
            value={v.id}
            checked={routeVehicleIds.has(v.id)}
          />{' '}
          {v.name}
        </label>
      ))}
    </fieldset>
    <fieldset class="card">
      <legend>Search & sharing</legend>
      <div class="grid">
        <Field
          name="metaTitle"
          label="SEO title"
          value={seo?.metaTitle}
          maxlength={70}
          hint="≤ 60 characters is ideal; brand is appended"
          errors={err.metaTitle}
        />
        <Field
          name="metaDescription"
          label="Meta description"
          type="textarea"
          value={seo?.metaDescription}
          maxlength={170}
          errors={err.metaDescription}
        />
        <Field
          name="canonicalPath"
          label="Canonical path"
          value={seo?.canonicalPath}
          maxlength={200}
          hint="Leave empty for /routes/<slug>/"
          errors={err.canonicalPath}
        />
        <Select
          name="robots"
          label="Robots"
          value={seo?.robots ?? ''}
          options={[
            { value: '', label: 'Default (index)' },
            { value: 'noindex,follow', label: 'noindex, follow' },
            { value: 'noindex,nofollow', label: 'noindex, nofollow' },
          ]}
        />
        <Field name="ogTitle" label="Social title" value={seo?.ogTitle} maxlength={90} />
        <Field
          name="ogDescription"
          label="Social description"
          type="textarea"
          value={seo?.ogDescription}
          maxlength={200}
        />
        <Select
          name="ogImageId"
          label="Social image"
          options={mediaOptions}
          value={seo?.ogImageId}
          empty="Hero image"
        />
      </div>
    </fieldset>
    <p>
      <button class="btn" type="submit">
        Save route
      </button>
    </p>
  </form>
</AdminLayout>
