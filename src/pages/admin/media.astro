---
import { actions } from 'astro:actions';
import AdminLayout from '../../layouts/AdminLayout.astro';
import Field from '../../components/admin/Field.astro';
import { feedbackFrom } from '../../lib/admin/feedback';
import { listMedia } from '../../lib/services/admin';

export const prerender = false;

const fb = feedbackFrom([
  Astro.getActionResult(actions.uploadMedia),
  Astro.getActionResult(actions.updateMedia),
]);
if (fb.ok) return Astro.redirect('/admin/media/?saved=1', 303);
const media = await listMedia();
const thumb = (m: (typeof media)[number]) =>
  `${m.basePath}-${Math.min(...m.variantWidths)}.${m.fallbackFormat}`;
---

<AdminLayout title="Media" section="media" feedback={fb}>
  <form
    class="card"
    method="POST"
    action={'/admin/media/' + actions.uploadMedia}
    enctype="multipart/form-data"
  >
    <strong>Upload an image</strong>
    <p class="muted">
      JPEG/PNG/WebP/AVIF up to 12 MB. Use your own photos, or photos whose licence you have checked.
      Responsive AVIF/WebP sizes are generated automatically.
    </p>
    <div class="grid">
      <div class="field">
        <label for="f-file">Image *</label>
        <input
          id="f-file"
          name="file"
          type="file"
          accept="image/jpeg,image/png,image/webp,image/avif"
          required
        />
      </div>
      <Field
        name="alt"
        label="Alt text (describe what is visible)"
        required
        maxlength={200}
        errors={fb.fields.alt}
      />
      <Field name="credit" label="Credit" maxlength={120} />
      <Field name="license" label="Licence" maxlength={120} />
    </div>
    <p>
      <button class="btn" type="submit">
        Upload
      </button>
    </p>
  </form>

  <table>
    <thead>
      <tr>
        <th>Image</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      {media.map((m) => (
        <tr>
          <td>
            <img
              src={thumb(m)}
              alt=""
              width="160"
              height={Math.round((160 * m.height) / m.width)}
              loading="lazy"
            />
          </td>
          <td>
            <form method="POST" action={'/admin/media/' + actions.updateMedia}>
              <input type="hidden" name="id" value={m.id} />
              <div class="grid">
                <Field name="alt" label="Alt text" value={m.alt} required maxlength={200} />
                <Field name="credit" label="Credit" value={m.credit} maxlength={120} />
                <Field name="license" label="Licence" value={m.license} maxlength={120} />
              </div>
              <p class="muted">
                {m.basePath} · {m.width}×{m.height}
                {m.note && (
                  <>
                    <br />⚠ {m.note}
                  </>
                )}
              </p>
              <button class="btn small" type="submit">
                Save
              </button>
            </form>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>
