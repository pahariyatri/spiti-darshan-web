# Spiti Darshan — build-time settings (static site). Copy to `.env` for local builds;
# on Vercel set them under Project → Settings → Environment Variables. Never commit `.env`.

# Canonical public origin, no trailing slash. On Vercel it defaults to the production domain.
PUBLIC_SITE_URL=https://your-verified-domain.example

# Optional override of the business WhatsApp number (country code + digits). The verified number
# +91 62300 70301 is already set in src/lib/config/site.ts; set this only to use a different one.
BUSINESS_WHATSAPP_NUMBER=
