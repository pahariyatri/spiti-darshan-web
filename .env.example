# Spiti Darshan — build-time settings (static site). Copy to `.env` for local builds;
# on Vercel set them under Project → Settings → Environment Variables. Never commit `.env`.

# REQUIRED. The business WhatsApp number used by every CTA (country code + digits).
BUSINESS_WHATSAPP_NUMBER=916230070301

# Canonical public origin, no trailing slash. On Vercel it defaults to the production domain.
PUBLIC_SITE_URL=https://your-domain.example

# Optional. Google Analytics 4 measurement ID (G-XXXXXXX) to receive `whatsapp_click` events.
PUBLIC_GA4_ID=
