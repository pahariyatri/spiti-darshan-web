# ---------------------------------------------------------------------------
# Spiti Darshan — environment. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
DATABASE_URL=postgres://spiti:change-me@localhost:5434/spiti_darshan

# Canonical public origin, no trailing slash (required; used for canonical URLs, sitemap, OG).
PUBLIC_SITE_URL=https://your-verified-domain.example

# Verified WhatsApp Business number: country code + digits only, e.g. 91XXXXXXXXXX.
# Leave EMPTY until the business confirms the number. When empty, CTAs open WhatsApp's
# contact picker with the prefilled message and the page shows the "Preview" note.
BUSINESS_WHATSAPP_NUMBER=

# Random secret, at least 32 characters (used to key session-token hashes).
# Generate with:  openssl rand -base64 48
SESSION_SECRET=

# Only used by `pnpm admin:create` (the password is prompted, never stored in env).
ADMIN_EMAIL=

# Where admin-uploaded images are stored on disk (must be persistent and backed up).
UPLOAD_DIR=./uploads

# Set to true ONLY when running behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false

# Rate limits (per client, per window). Defaults shown.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_EVENTS_MAX=60
RATE_LIMIT_EVENTS_WINDOW_SECONDS=60

# Optional: cache lifetime (seconds) for SSR route pages at the proxy/CDN.
ROUTE_PAGE_CACHE_SECONDS=300
